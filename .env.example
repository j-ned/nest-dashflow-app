NODE_ENV=development
PORT=3001
# DB locale partagée (Podman) — cf. compose.dev.yaml
DATABASE_URL=postgresql://djoudj:dashflow_dev_pw@localhost:5432/dashflow_db
# ── Même variable EN PROD (utilisée par `db:migrate` et l'adoption baseline) ──
# C'est la connexion à la base de PROD, pas localhost. Ne PAS committer les vrais identifiants.
#   DATABASE_URL=postgresql://<user>:<password>@<host-prod>:5432/<db-prod>
CORS_ORIGIN=http://localhost:4200
JWT_SECRET=dev-secret-change-me-min-32-characters-long-xxxxx
MAILER=console
APP_URL=http://localhost:3001
# Compte démo public (login sans mot de passe + reset). Mettre false en prod si non souhaité.
DEMO_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ── Cloudflare R2 (storage) ──
# endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# ── SMTP (mailer = smtp) — ex. Infomaniak : mail.infomaniak.com:587 ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DashFlow <noreply@example.com>
# ── Stripe (billing). Optionnel : l'app boote sans, mais checkout/portal/webhook échouent. ──
# Dashboard Stripe → Developers → API keys → "Secret key" (sk_test_… en test, sk_live_… en prod)
STRIPE_SECRET_KEY=
# Secret de signature du endpoint webhook.
#   - en local : donné par `stripe listen --forward-to localhost:3001/billing/webhook` (whsec_…)
#   - en prod  : Dashboard Stripe → Developers → Webhooks → ton endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_…) des 2 produits/prix mensuels créés dans Stripe → Products.
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_FAMILY_HEALTH=
