NODE_ENV=development
PORT=3001
# DB locale partagée (Podman) — cf. compose.dev.yaml
DATABASE_URL=postgresql://djoudj:dashflow_dev_pw@localhost:5432/dashflow_db
CORS_ORIGIN=http://localhost:4200
JWT_SECRET=dev-secret-change-me-min-32-characters-long-xxxxx
MAILER=console
APP_URL=http://localhost:3001
# Compte démo public (login sans mot de passe + reset). Mettre false en prod si non souhaité.
DEMO_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ── Cloudflare R2 (storage) ──
# endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# ── SMTP (mailer = smtp) — ex. Infomaniak : mail.infomaniak.com:587 ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DashFlow <noreply@example.com>
